# =============================================
# HOTEL ANGELES - BACKEND
# Copia este archivo a ".env" y llena los valores.
# NUNCA subas el archivo ".env" real al repositorio.
# =============================================

# Puerto del servidor
PORT=5000

# Configuración de MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=TU_USUARIO_BD
DB_PASSWORD=TU_PASSWORD_BD
DB_NAME=prestige_inn

# JWT - Clave secreta (usa una larga y aleatoria, ej: openssl rand -hex 32)
JWT_SECRET=TU_CLAVE_SECRETA_SUPER_SEGURA

# Correo (Gmail u otro SMTP)
EMAIL_USER=TU_CORREO_RESERVAS@GMAIL.COM
EMAIL_PASS=TU_APP_PASSWORD_DE_GMAIL

# URL del frontend (para CORS y carga de imágenes en desarrollo)
FRONTEND_URL=http://TU_IP_VPS:5000
